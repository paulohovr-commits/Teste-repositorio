# Estas 3 variáveis vão na Vercel: Project → Settings → Environment Variables.
# Pegue os valores no Supabase: Project Settings → API (ou "API Keys").

# Project URL (ex: https://abcdefgh.supabase.co)
SUPABASE_URL=

# Chave pública: "anon public" (ou "publishable", que começa com sb_publishable_)
SUPABASE_ANON_KEY=

# Chave SECRETA: "service_role" (ou "secret", que começa com sb_secret_)
# NUNCA coloque essa chave no navegador nem no GitHub.
SUPABASE_SERVICE_ROLE_KEY=
