# Copie para .env.local e preencha (os mesmos valores vão na Vercel).
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# O dono do sistema: cria quadros e etapas. Use o mesmo e-mail do supabase/f00.sql.
NEXT_PUBLIC_OWNER_EMAIL=
# Quem pode entrar (aviso na tela; a tranca de verdade é a tabela acesso_permitido).
# Separe por vírgula. Domínio sem @ (ex: suaempresa.com.br) ou e-mail inteiro.
NEXT_PUBLIC_ALLOWED=
